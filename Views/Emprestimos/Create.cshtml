@model Emprestimo
@{
    ViewData["Title"] = "Novo Empréstimo";
}

<h1>Novo Empréstimo</h1>

@if (!(ViewBag.LivroId as SelectList)?.Any() ?? true)
{
    <p>Cadastre pelo menos um livro e um usuário antes de criar um empréstimo.</p>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="LivroId"></label>
    <select asp-for="LivroId" asp-items="ViewBag.LivroId">
        <option value="">Selecione um livro</option>
    </select>
    <span asp-validation-for="LivroId"></span>
    <br />

    <label asp-for="UsuarioId"></label>
    <select asp-for="UsuarioId" asp-items="ViewBag.UsuarioId">
        <option value="">Selecione um usuário</option>
    </select>
    <span asp-validation-for="UsuarioId"></span>
    <br />

    <label asp-for="DataEmprestimo"></label>
    <input asp-for="DataEmprestimo" type="date" />
    <span asp-validation-for="DataEmprestimo"></span>
    <br />

    <label asp-for="DataDevolucao"></label>
    <input asp-for="DataDevolucao" type="date" />
    <span asp-validation-for="DataDevolucao"></span>
    <br />

    <label asp-for="Status"></label>
    <select asp-for="Status">
        <option value="Ativo">Ativo</option>
        <option value="Devolvido">Devolvido</option>
        <option value="Atrasado">Atrasado</option>
    </select>
    <span asp-validation-for="Status"></span>
    <br />

    <button type="submit">Salvar</button>
</form>

<p><a asp-action="Index">Voltar</a></p>
